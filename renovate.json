{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "addLabels": [
    "renovate"
  ],
  "automergeStrategy": "rebase",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^.*docker-compose\\.json$/"
      ],
      "matchStrings": [
        "\"image\": \"(?<depName>.*?):(?<currentValue>.*?)\","
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": false
    },
    {
      "matchDepTypes": [
        "devDependencies"
      ],
      "automerge": false
    },
    {
      "description": "Backing services are pinned to the version each upstream app expects; do not auto-update them. Docker datasource reports names with a registry/namespace prefix (e.g. docker.io/postgres, postgis/postgis, getmeili/meilisearch), so match on a trailing path segment.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/(^|/)(mariadb|mysql|mongodb|postgres|postgis|pgvector|redis|meilisearch)$/"
      ],
      "enabled": false
    },
    {
      "description": "Apps whose services are published as several images from one upstream release. Renovate would otherwise open a PR per image, and until every one is merged the store ships a mismatched pair (and config.json advertises a version no single image is on). Grouping keeps each app's images in one PR so they move together. Matched on a trailing path segment, like the backing-services rule above.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/(^|/)adventurelog-(frontend|backend)$/"
      ],
      "groupName": "AdventureLog"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/(^|/)aeterna-(frontend|backend)$/"
      ],
      "groupName": "Aeterna"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/(^|/)opengym/(web|api)$/"
      ],
      "groupName": "openGym"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/(^|/)securo-(frontend|backend)$/"
      ],
      "groupName": "Securo"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/(^|/)wanderer-(web|db)$/"
      ],
      "groupName": "Wanderer"
    }
  ],
  "postUpgradeTasks": {
    "commands": [
      "bun ./scripts/update-config.ts {{packageFile}} {{newVersion}}",
      "bun install && bun run test"
    ],
    "fileFilters": [
      "**/*"
    ],
    "executionMode": "update"
  }
}
