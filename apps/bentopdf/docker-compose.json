{
  "schemaVersion": 2,
  "services": [
    {
      "name": "bentopdf",
      "image": "ghcr.io/alam00000/bentopdf-simple:v2.8.8",
      "isMain": true,
      "internalPort": 8080,
      "environment": [
        {
          "key": "PORT",
          "value": "8080"
        },
        {
          "key": "TZ",
          "value": "${TZ}"
        }
      ],
      "healthCheck": {
        "test": "wget --no-verbose --tries=1 --spider http://127.0.0.1:8080/ || exit 1",
        "interval": "30s",
        "timeout": "5s",
        "retries": 3,
        "startPeriod": "20s"
      }
    }
  ]
}
