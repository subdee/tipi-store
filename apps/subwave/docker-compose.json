{
  "schemaVersion": 2,
  "services": [
    {
      "name": "subwave",
      "image": "ghcr.io/perminder-klair/subwave-aio:1.16.0",
      "isMain": true,
      "internalPort": 80,
      "environment": [
        {
          "key": "ADMIN_USER",
          "value": "${SUBWAVE_ADMIN_USER}"
        },
        {
          "key": "ADMIN_PASS",
          "value": "${SUBWAVE_ADMIN_PASS}"
        },
        {
          "key": "SITE_URL",
          "value": "${SUBWAVE_SITE_URL:-}"
        },
        {
          "key": "ICECAST_MAX_CLIENTS",
          "value": "${SUBWAVE_MAX_CLIENTS:-}"
        },
        {
          "key": "TZ",
          "value": "${TZ}"
        }
      ],
      "extraHosts": [
        "host.docker.internal:host-gateway"
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/state",
          "containerPath": "/var/sub-wave",
          "readOnly": false,
          "shared": false,
          "private": false
        }
      ]
    }
  ]
}
