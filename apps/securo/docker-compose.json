          "private": false
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/agent_knowledge",
          "containerPath": "/app/data/agent_knowledge",
          "readOnly": false,
          "shared": false,
          "private": false
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/embedding_models",
          "containerPath": "/app/data/embedding_models",
          "readOnly": false,
          "shared": false,
          "private": false
        },
        {
          "hostPath": "${APP_DATA_DIR}/secrets",
          "containerPath": "/app/secrets",
          "readOnly": true,
          "shared": false,
          "private": false
        }
      ],
      "extraHosts": [
        "host.docker.internal:host-gateway"
      ],
      "dependsOn": {
        "db": {
          "condition": "service_healthy"
        },
        "redis": {
          "condition": "service_healthy"
        }
      },
      "internalPort": 8765
    },
    {
      "name": "db",
      "image": "pgvector/pgvector:pg16",
      "internalPort": 5432,
      "environment": [
        {
          "key": "POSTGRES_USER",
          "value": "securo"
        },
        {
          "key": "POSTGRES_PASSWORD",
          "value": "${DB_PASSWORD}"
        },
        {
          "key": "POSTGRES_DB",
          "value": "securo"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/postgres",
          "containerPath": "/var/lib/postgresql/data",
          "readOnly": false,
          "shared": false,
          "private": false
        }
      ],
      "healthCheck": {
        "test": "pg_isready -U securo -d securo || exit 1",
        "interval": "10s",
        "timeout": "5s",
        "retries": 10,
        "startPeriod": "30s"
      }
    },
    {
      "name": "redis",
      "image": "redis:8-alpine",
      "internalPort": 6379,
      "healthCheck": {
        "test": "redis-cli ping || exit 1",
        "interval": "10s",
        "timeout": "5s",
        "retries": 10,
        "startPeriod": "10s"
      }
    }
  ]
}
