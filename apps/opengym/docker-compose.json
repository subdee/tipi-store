{
  "schemaVersion": 2,
  "services": [
    {
      "name": "web",
      "image": "registry.gitlab.com/duartesantos8/opengym/web:1.4.2",
      "isMain": true,
      "internalPort": 80,
      "environment": [
        {
          "key": "NGINX_PORT",
          "value": "80"
        },
        {
          "key": "BACKEND",
          "value": "api"
        },
        {
          "key": "PORT",
          "value": "3000"
        },
        {
          "key": "TZ",
          "value": "${TZ}"
        }
      ],
      "dependsOn": {
        "api": {
          "condition": "service_started"
        }
      },
      "healthCheck": {
        "test": "wget --spider -q http://127.0.0.1:80/ || exit 1",
        "interval": "10s",
        "timeout": "5s",
        "retries": 3,
        "startPeriod": "40s"
      }
    },
    {
      "name": "api",
      "image": "registry.gitlab.com/duartesantos8/opengym/api:1.4.2",
      "internalPort": 3000,
      "healthCheck": {
        "test": "wget --spider -q http://127.0.0.1:3000/api/health || exit 1",
        "interval": "10s",
        "timeout": "5s",
        "retries": 3,
        "startPeriod": "40s"
      },
      "environment": [
        {
          "key": "PORT",
          "value": "3000"
        },
        {
          "key": "DATA_DIR",
          "value": "/data"
        },
        {
          "key": "ORIGIN",
          "value": "${OPENGYM_ORIGIN}"
        },
        {
          "key": "RP_ID",
          "value": "${OPENGYM_RP_ID}"
        },
        {
          "key": "RP_NAME",
          "value": "openGym"
        },
        {
          "key": "ADMIN_UIDS",
          "value": "${OPENGYM_ADMIN_UIDS:-}"
        },
        {
          "key": "TZ",
          "value": "${TZ}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/app",
          "containerPath": "/data",
          "readOnly": false,
          "shared": false,
          "private": false
        }
      ]
    }
  ]
}
